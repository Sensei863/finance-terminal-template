# ==============================================================================
# Backend Environment Configuration (.env)
# ==============================================================================

# Database Connection (Local PostgreSQL or Cloud Supabase/Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# LEDGER_DATABASE_URL=postgresql://...
# APP_DATABASE_URL=postgresql://...

# AI Provider API Key (Claude Anthropic or Google Gemini for Screener & Newsletters)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (Comma-separated URLs of your frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Email Dispatch & Alerts (Gmail App Password)
# SENDER_EMAIL=your-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# RECIPIENT_EMAIL=recipient@example.com
