# ==============================================================================
# Frontend Environment Configuration (.env.local)
# ==============================================================================

# URL of the FastAPI Backend
# Local PC development: http://localhost:8000
# Cloud deployment (Render / Railway): https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional UI Passcode Lock (Leave blank or set your own passcode)
APP_PASSCODE=1234
NEXT_PUBLIC_APP_PASSCODE=1234
